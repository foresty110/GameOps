# Copy this file to .env and adjust as needed. .env is gitignored.

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=gameops
MYSQL_USER=gameops
MYSQL_PASSWORD=gameops
MYSQL_PORT=3306

# Redis
REDIS_PORT=6379

# Backend (used from Day 1-6 onward)
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-bytes-long-please
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7
SPRING_PROFILES_ACTIVE=local
